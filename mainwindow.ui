        <item>
         <widget class="QListWidget" name="MusicListWidget">
          <property name="styleSheet">
           <string notr="true">/* 列表整体样式 */
QListWidget {
    background-color: rgb(211, 211, 211);
    border: 1px solid #e0e0e0; /* 轻微边框，增加层次感 */
    border-radius: 8px; /* 圆角，贴合手机UI风格 */
    font-size: 15px; /* 手机端合适的字体大小 */
    color: #333333; /* 常规文字颜色 */
}

/* 列表条目默认样式 */
QListWidget::item {
    height: 45px; /* 手机端手指点击的舒适高度 */
    padding-left: 15px; /* 文字左间距，避免贴边 */
}

/* 高亮（选中）状态样式 */
QListWidget::item:selected {
    background-color: rgb(152, 152, 152); 
    color: black;
}</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_13">
          <item>
           <layout class="QVBoxLayout" name="verticalLayout_5">
            <item>
             <layout class="QHBoxLayout" name="horizontalLayout_9">
              <item>
               <widget class="QSlider" name="ProgressSlider">
                <property name="minimumSize">
                 <size>
                  <width>0</width>
                  <height>70</height>
                 </size>
                </property>
                <property name="styleSheet">
                 <string notr="true">/* 横屏音量滑块 - 适配手机触摸（核心样式） */
QSlider::groove:horizontal {
    height: 24px;
    background: #f0f0f0;
    border-radius: 12px;
    margin: 8px 0;
}

QSlider::sub-page:horizontal {
    background: #2196F3;
    border-radius: 12px;
}

QSlider::handle:horizontal {
    background: white;
    border: 4px solid #2196F3;
    width: 40px;
    height: 40px;
    margin: -16px 0;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

QSlider::handle:horizontal:pressed {
    background: #2196F3;
    border-color: #1976D2;
    transform: scale(1.1);
}

/* 竖屏滑块样式（如果需要垂直滑块则保留，不需要可删除） */
QSlider::groove:vertical {
    width: 24px;
    background: #f0f0f0;
    border-radius: 12px;
    margin: 0 8px;
}

QSlider::sub-page:vertical {
    background: #2196F3;
    border-radius: 12px;
}

QSlider::handle:vertical {
    background: white;
    border: 4px solid #2196F3;
    width: 40px;
    height: 40px;
    margin: 0 -16px;
    border-radius: 20px;
