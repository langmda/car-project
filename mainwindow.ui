              <property name="styleSheet">
               <string notr="true">/* 竖屏滑块样式 */
QSlider::groove:vertical {
    width: 24px;
    background: #f0f0f0;
    border-radius: 12px;
    /* 移除 margin，让进度条和轨道完全贴合 */
}

/* add-page: 滑块到最大值的区域（竖直滑块的最大值在下方，所以这里设置蓝色） */
QSlider::add-page:vertical {
    background: #2196F3;
    border-radius: 12px;
    /* 关键：设置与轨道一致的内边距，避免进度条超出轨道 */
    margin: 0;
}

/* sub-page: 滑块到最小值的区域（竖直滑块的最小值在上方，所以这里设为白色） */
QSlider::sub-page:vertical {
    background: #f0f0f0;
    border-radius: 12px;
    margin: 0;
}

QSlider::handle:vertical {
    background: white;
    border: 4px solid #2196F3;
    width: 40px;
    height: 40px;
    margin: 0 -16px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

QSlider::handle:vertical:pressed {
    background: #2196F3;
    border-color: #1976D2;
    transform: scale(1.1);
}</string>
